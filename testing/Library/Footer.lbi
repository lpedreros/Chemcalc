<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<!-- Donate — top of the bottom-right floating-action cluster (with the
     BoatMD chat toggle from chatbot_styles.css and the page Help button
     from Library/HelpButton.lbi below it; see --chrome-fab-right and
     .fab-donate in style.css). Trigger + modal chrome restyled to tokens
     only — the PayPal form fields below are unchanged. -->
<button id="donateButton" class="fab-donate d-print-none" data-toggle="modal" data-target="#donationModal">
  <svg width="16" height="16" aria-hidden="true"><use href="#icon-heart-handshake"/></svg>
  <span class="fab-donate-label">Donate</span>
</button>

<!-- Donation Modal (PayPal snippet unchanged) -->
<div class="modal fade" id="donationModal" tabindex="-1" role="dialog" aria-labelledby="donationModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content fab-donate-modal">
      <div class="modal-header">
        <h5 class="modal-title" id="donationModalLabel">Support ChemCalc</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body">
        <p> Fuel our mission! Donate now to keep ChemCalc thriving and empower marine repair excellence. </p>
        <p> Your support goes toward site development, content updates, and continuous improvement of our services. </p>
        <hr>
        <div class="donation-options">
          <form action="https://www.paypal.com/donate" method="post" target="_top">
            <input type="hidden" name="business" value="MRVYZ5WXYR6SC" />
            <input type="hidden" name="no_recurring" value="0" />
            <input type="hidden" name="item_name" value="Fuel our mission! Donate now to keep ChemCalc thriving and empower marine repair excellence." />
            <input type="hidden" name="currency_code" value="USD" />
            <input type="image" src="https://www.paypalobjects.com/en_US/i/btn/btn_donateCC_LG.gif" border="0" name="submit" title="PayPal - The safer, easier way to pay online!" alt="Donate with PayPal button" />
            <img alt="" border="0" src="https://www.paypal.com/en_US/i/scr/pixel.gif" width="1" height="1" />
          </form>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Footer Section -->
<footer class="footer site-footer-dark">
  <div class="site-footer-inner">
    <div class="site-footer-brand">
      <span class="site-footer-badge" aria-hidden="true">T&amp;E</span>
      <span class="site-footer-brand-text">
        <span class="site-footer-brand-name">Think &amp; Engage</span>
        Parent brand of ChemCalc
      </span>
    </div>
    <div class="legal-links mb-2">
      <a href="/privacy.html">Privacy Policy</a> |
      <a href="/terms.html">Terms of Use</a> |
      <a href="/cookie.html">Cookie Policy</a>
    </div>
    <p class="mb-2">&copy; 2026 ChemCalc. All rights reserved.</p>
  </div>
</footer>
