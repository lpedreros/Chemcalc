<!-- Floating Help Button — bottom of the bottom-right floating-action
     cluster (closest to the screen edge; see --chrome-fab-right and
     .help-float-btn in style.css). Restyled trigger only —
     onclick="openHelpModal()" and each page's #helpModal / helpContent
     tiers are unchanged. -->
<!-- Each page must have its own help modal with a matching data-target ID -->
<!-- Pattern: data-target="#pageNameHelpModal" — see estimate.html for reference -->
<button class="help-float-btn d-print-none" id="helpFloatBtn" onclick="openHelpModal()" title="How to use this page">
  <span aria-hidden="true">?</span>
</button>
