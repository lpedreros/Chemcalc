# ── Cache Control ──────────────────────────────────────────────
# HTML files: always revalidate (never serve stale HTML from cache)
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# JS and CSS: browser caches the file, but must revalidate with the
# server on every load before using it -- a cheap 304 if unchanged,
# a fresh copy the instant a deploy actually changes the file. No
# manual cache-busting (?v=N) ever needed. (Changed 2026-09-06 from
# "public, max-age=31536000, immutable" -- that was serving returning
# visitors a stale copy of every JS/CSS file for up to a year with no
# way to force a refresh short of a hard reload/cleared cache. This is
# what was silently masking the hamburger-menu fix on 2026-09-06.)
<FilesMatch "\.(js|css)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# Images: cache for 30 days
<FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|webp)$">
  Header set Cache-Control "public, max-age=2592000"
</FilesMatch>

# ── Deny Dreamweaver Bookkeeping Files ─────────────────────────
# _notes/ directories (Library/_notes/, images/_notes/) hold
# Dreamweaver's dwsync.xml files, which record the origin server's
# path and IP. They currently return 404 only because of the host's
# own default behavior for this path, not anything in this repo --
# that protection would not follow the files to a different host.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(^|/)_notes(/|$)" - [F,L]
  RewriteRule "(^|/)\.ftp-deploy-sync-state\.json$" - [F,L]
</IfModule>

# -- Keep the staging host out of search and AI indexes ---------------
# testing.chemcalc.co serves the same pages as production, and robots.txt
# (shared with production) allows everything, so the staging host could be
# indexed alongside chemcalc.co. This sends noindex ONLY when the request host
# starts with "testing." -- the production host is unaffected, so this file can
# still be copied to the production root as-is.
<IfModule mod_headers.c>
  SetEnvIfNoCase Host "^testing\." STAGING_HOST=1
  Header set X-Robots-Tag "noindex, nofollow" env=STAGING_HOST
</IfModule>
