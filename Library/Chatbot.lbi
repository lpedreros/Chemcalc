<meta http-equiv="Content-Type" content="text/html; charset=utf-8"><!-- ============================================================
     BOTTOM of every page, immediately before the closing </body> tag.
     
     What it does:
     - Loads the Supabase JS library (CDN)
     - Loads supabase-client.js (shared DB connection)
     - Loads chatbot.js (BoatMD — appears on every page)
     
     To add a new global script in future:
     Add ONE line here. It will apply to all pages.
     ============================================================ -->

<!-- Supabase JS Library & Shared Client -->
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="supabase-client.js"></script>

<!-- BoatMD Chatbot (global — loads on every page) -->
<script src="chatbot.js"></script>
